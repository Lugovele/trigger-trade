# TriggerTrade runtime
TRIGGERTRADE_RUNTIME_MODE=development

# Trading mode
TRIGGERTRADE_TRADING_MODE=paper
TRIGGERTRADE_EXECUTION_VENUE=bybit_demo

# Exchange
TRIGGERTRADE_EXCHANGE=bybit
TRIGGERTRADE_BYBIT_ENV=demo

# Bybit Demo API credentials
BYBIT_API_KEY=PASTE_YOUR_DEMO_API_KEY_HERE
BYBIT_API_SECRET=PASTE_YOUR_DEMO_API_SECRET_HERE

# Bybit Demo REST endpoint
BYBIT_BASE_URL=https://api-demo.bybit.com

# Initial market scope
TRIGGERTRADE_MARKET=spot
TRIGGERTRADE_WATCHLIST=BTCUSDT

# Demo-only deterministic vertical-slice config, not a production trading rule.
TRIGGERTRADE_TRG_001_LOOKBACK_WINDOW=1m
TRIGGERTRADE_TRG_001_THRESHOLD_PCT=-1.0
TRIGGERTRADE_STR_001_ENABLED=true
TRIGGERTRADE_MAX_DEMO_ORDER_NOTIONAL=6
TRIGGERTRADE_STALE_AFTER_SECONDS=60

# Safety
TRIGGERTRADE_LIVE_TRADING_ENABLED=false
